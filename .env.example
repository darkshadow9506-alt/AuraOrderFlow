# Copy to .env (local) or set as GitHub Actions / host secrets.
# -------------------------------------------------------------------

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token

# One or more chat ids, comma-separated. Get yours by messaging the bot then
# visiting https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_CHAT_ID=123456789

# Optional: log verbosity (DEBUG / INFO / WARNING)
LOG_LEVEL=INFO

# Optional: stop cleanly after N seconds so a scheduler can restart the bot.
# GitHub Actions caps a job at 6h — 21000s (~5h50m) leaves margin. Set to 0 (or
# leave unset) for always-on hosts that keep the process alive themselves.
MAX_RUNTIME_SECONDS=0
